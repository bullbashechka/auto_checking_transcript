TELEGRAM_TOKEN=put_your_telegram_bot_token_here
OPENAI_API_KEY=put_your_openai_api_key_here

ALLOWED_USER_IDS=123456789,987654321

# Открытый режим (любой Telegram-пользователь сможет писать боту).
# Использовать ТОЛЬКО для локальной отладки. На VPS оставлять пустым.
ALLOW_ANY=

OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
LLM_CONCURRENCY=3
# Effective limiter budget = OPENAI_TPM_LIMIT * OPENAI_TPM_UTILIZATION.
OPENAI_TPM_LIMIT=200000
OPENAI_TPM_UTILIZATION=0.80
